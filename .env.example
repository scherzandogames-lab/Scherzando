# ─────────────────────────────────────────────────────────────
#  Variables de entorno de SCHERZANDO. Se cargan en Netlify:
#  Site configuration → Environment variables. Nunca se suben a GitHub.
# ─────────────────────────────────────────────────────────────

# Dirección pública del sitio, sin barra final.
SITE_URL=

# Supabase (proyecto PROPIO de Scherzando, separado del libro)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Panel de administración
ADMIN_PASSWORD=
SESSION_SECRET=
ADMIN_EMAIL=scherzandogames@gmail.com

# Correo saliente (Gmail de Scherzando con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=scherzandogames@gmail.com
SMTP_PASS=
EMAIL_FROM="SCHERZANDO.AR <scherzandogames@gmail.com>"
RESEND_API_KEY=

# Correo Argentino · API MiCorreo (credenciales que entrega Correo Argentino)
MICORREO_USER=
MICORREO_PASSWORD=
MICORREO_CUSTOMER_ID=
# "test" o "prod"
MICORREO_ENV=test

# Meta Pixel (opcional). Es público por naturaleza: lo ve cualquier navegador.
NEXT_PUBLIC_META_PIXEL_ID=

